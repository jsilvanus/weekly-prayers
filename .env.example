# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database (either DATABASE_URL or individual DB_* settings)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=prayers
DB_PASSWORD=prayers_secret
DB_NAME=weekly_prayers
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# OIDC / Tunnus Authentication
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=weekly-prayers
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_SCOPES=openid profile email groups
# Map user roles: supports pattern parish/<tenant>/rukous-<role> or explicit JSON map:
# OIDC_GROUP_ROLE_MAP={"parish/*/rukous-worker":"worker","parish/*/rukous-admin":"admin"}
OIDC_GROUP_ROLE_MAP={}
DEFAULT_TENANT_SLUG=riihimaki
ADMIN_EMAILS=

# Microsoft Entra ID (Azure AD) - optional / fallback
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Weekly prayer email (Tunnus mail relay via @tunnus/notify).
# The scheduler stays off unless TUNNUS_MAIL_URL, TUNNUS_MAIL_RELAY_TOKEN and MAIL_FROM are all set.
TUNNUS_MAIL_URL=https://tunnus.example.com
TUNNUS_MAIL_RELAY_TOKEN=
MAIL_FROM=
# Set to false to turn the periodic sender off even when the relay is configured
MAILING_SCHEDULER=true

# AI Service (OpenAI or Anthropic)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Docker Compose ports
BACKEND_PORT=3000
FRONTEND_PORT=8080
